OPENAI_API_KEY=your_openai_api_key

# Brave Search API key, used by the chapter 9 and 10 research agents
# (https://brave.com/search/api/)
BRAVE_API_KEY=your_brave_api_key

# Model for every agent that does not name one. Without it, openai-agents
# falls back to its own default, which changes between releases.
OPENAI_DEFAULT_MODEL=gpt-5.1
