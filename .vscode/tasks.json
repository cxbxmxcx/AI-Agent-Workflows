{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Install requirements",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": ["-m", "pip", "install", "--disable-pip-version-check", "-r", "requirements.txt"],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}